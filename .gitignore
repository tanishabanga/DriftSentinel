
# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================
.venv/
.venv*/
venv/
env/

# ============================================================
# DATASETS
# ============================================================
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# ============================================================
# MODEL ARTIFACTS
# ============================================================
artifacts/*

!artifacts/xgboost/
artifacts/xgboost/*
!artifacts/xgboost/feature_schema.json
!artifacts/xgboost/fraud_model.json
!artifacts/xgboost/calibration/
artifacts/xgboost/calibration/*
!artifacts/xgboost/calibration/isotonic_calibrator.joblib
!artifacts/xgboost/calibration/sigmoid_calibrator.joblib
# Required temporal research models
!artifacts/temporal/
artifacts/temporal/*
!artifacts/temporal/baseline_model.joblib
!artifacts/temporal/matched_size_model.joblib
!artifacts/temporal/recent_only_model.joblib
!artifacts/temporal/retrained_model.joblib

# Required monitoring runtime profile
!artifacts/monitoring/
artifacts/monitoring/*
!artifacts/monitoring/reference_profile.json

# ============================================================
# EXPERIMENT OUTPUTS
# Keep research summaries, metadata, CSVs and plots.
# Exclude regenerable prediction datasets and transaction reports.
# ============================================================
experiments/results/**/*.parquet
experiments/results/decision_report.csv

# ============================================================
# JUPYTER
# ============================================================
.ipynb_checkpoints/

# ============================================================
